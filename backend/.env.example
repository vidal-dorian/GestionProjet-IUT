DATABASE_URL=mysql+pymysql://gestionprojet:gestionprojet@localhost:3306/gestionprojet
CORS_ORIGINS=http://localhost:5173

# Développement local uniquement : en l'absence de Cloudflare Access devant
# l'application, permet de s'authentifier via l'en-tête non vérifié
# X-Dev-Email (voir frontend/.env.example, VITE_DEV_EMAIL). Ne JAMAIS activer
# en production — CLOUDFLARE_TEAM_DOMAIN et CLOUDFLARE_ACCESS_AUD (voir
# docs/deploiement-raspberry-pi.md) doivent être renseignés à la place.
DEV_BYPASS_AUTH_ENABLED=true
