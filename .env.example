# Copier ce fichier vers .env et renseigner des valeurs réelles avant de lancer
# `docker compose up -d`. Ne jamais committer le fichier .env rempli.

# --- Base de données ---
MYSQL_DATABASE=gestionprojet
MYSQL_USER=gestionprojet
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- Backend ---
# Origine(s) publique(s) autorisées à appeler l'API (séparées par des virgules).
# En déploiement derrière le reverse-proxy nginx fourni (docker-compose.yml),
# c'est le même hostname que celui utilisé pour accéder à l'application.
CORS_ORIGINS=https://suivi.exemple.com
# Token optionnel pour l'API GitHub (dépôts privés, quota plus élevé).
GITHUB_TOKEN=

# --- Authentification (Cloudflare Access) ---
# L'application est protégée par Cloudflare Access (Google comme fournisseur
# d'identité) : voir docs/deploiement-raspberry-pi.md pour la configuration
# complète. Ces deux valeurs viennent de l'application Access créée dans le
# tableau de bord Cloudflare Zero Trust.
#
# Domaine de l'équipe Cloudflare Zero Trust (ex. : mon-equipe.cloudflareaccess.com).
CLOUDFLARE_TEAM_DOMAIN=mon-equipe.cloudflareaccess.com
# "Application Audience (AUD) Tag" de l'application Access créée pour ce site.
CLOUDFLARE_ACCESS_AUD=change-me

# --- Frontend ---
# Laisser vide : le frontend appelle l'API en same-origin via le
# reverse-proxy nginx (voir frontend/nginx.conf). Ne renseigner une valeur
# que si le frontend est déployé séparément du backend, sur un autre domaine.
VITE_API_URL=
# Port local sur lequel le frontend (nginx) est exposé côté hôte.
FRONTEND_PORT=8080
